PORT=3000
# Maximum P2P transfer size in decimal bytes (12 GB).
MAX_FILE_SIZE=12000000000

# Comma-separated browser origins. Leave empty to allow only the same origin.
ALLOWED_ORIGINS=

# Optional coturn REST-auth configuration. Leave both empty to use STUN only.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
